# =============================================================================
# IPTV Proxmox Stack - Переменные окружения
# =============================================================================
# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env
# =============================================================================

# Часовой пояс контейнеров
TZ=Europe/Moscow

# URL для загрузки XMLTV EPG
# Поддерживает прямые ссылки и gzip (.gz)
# Пример: https://example.com/epg.xml.gz
EPG_URL=

# Интервал обновления EPG в секундах (по умолчанию: 60)
EPG_INTERVAL=60

# Порт Threadfin (внутренний, пробрасывается через SSH туннель)
THREADFIN_PORT=34400

# Порт Nginx (внешний, для раздачи плейлистов)
NGINX_PORT=8080

# Таймаут проверки канала в секундах
CHECK_TIMEOUT=5

# Количество потоков для проверки каналов
CHECK_WORKERS=20
